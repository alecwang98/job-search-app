# Copy this file to .env and fill in your local key.
# .env is gitignored and should not be committed.

# Preferred app-specific key name. OPENAI_API_KEY also works.
JOBSEARCH_LLM_API_KEY=your_api_key_here

# Optional OpenAI-compatible provider settings.
# JOBSEARCH_LLM_BASE_URL=https://api.openai.com/v1
# JOBSEARCH_LLM_MODEL=gpt-4o-mini
